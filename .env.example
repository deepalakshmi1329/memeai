# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Model identifiers for Gemini
GEMINI_TEXT_MODEL="gemini-3.8-flash"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-lite-image"

# External GIF search APIs (optional; fallback curated providers are active if omitted)
GIPHY_API_KEY="MY_GIPHY_API_KEY"
TENOR_API_KEY="MY_TENOR_API_KEY"

# Supabase PostgreSQL & Storage credentials (optional; fallback SQLite/JSON storage active if omitted)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
PORT=3000

